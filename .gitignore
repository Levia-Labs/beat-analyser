# Source is tracked. Everything the app or a tool produces is not.

# Runtime data: uploaded audio, CSVs, ZIPs. The placeholder keeps the bind-mount target.
uploads/*
!uploads/.gitpreserve

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Rust build output (task rust:* keeps it in a Docker volume; a host cargo writes it here).
beatcore/target/

# Tool output. .cache/fixtures/ holds clips written by task dev:fixture.
.cache/
graphify-out/
*.log

# Machine-local Claude Code state. settings.json is shared and tracked; settings.local.json
# holds one machine's paths and overrides. Skills are user-scoped unless .claude/README.md
# lists them.
.claude/settings.local.json
.claude/skills/*
!.claude/skills/humanizer/
.claude/plugins/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

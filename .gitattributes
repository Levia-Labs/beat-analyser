# Edited on Windows, run in a Linux container. A CRLF in a Dockerfile RUN line or a shell
# block breaks it with an error that names the wrong line, so text is LF everywhere.

* text=auto eol=lf

*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.baseline text eol=lf
Dockerfile text eol=lf

*.wav  binary
*.mp3  binary
*.flac binary
*.ogg  binary
*.zip  binary
*.onnx binary
*.rs   text eol=lf
Cargo.lock text eol=lf
*.png  binary

# Shared with Crepidoma.
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.svg binary
*.cmd text eol=crlf
*.bat text eol=crlf
*.pdf binary
*.sh text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
